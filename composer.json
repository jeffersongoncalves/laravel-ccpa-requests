{
    "name": "jeffersongoncalves/laravel-ccpa-requests",
    "description": "CCPA/CPRA consumer requests for Laravel: right to know, delete and correct, verification, 10-business-day acknowledgement, 45-day deadline with one 45-day extension, automatic export and deletion.",
    "keywords": [
        "laravel",
        "ccpa",
        "cpra",
        "consumer-requests",
        "right-to-know",
        "right-to-delete",
        "privacy"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-ccpa-requests",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "jeffersongoncalves/laravel-ccpa": "^2.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "jeffersongoncalves/pest-plugin-database-migrations": "^1.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\CcpaRequests\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\CcpaRequests\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\CcpaRequests\\CcpaRequestsServiceProvider"
            ],
            "aliases": {
                "CcpaRequests": "JeffersonGoncalves\\CcpaRequests\\Facades\\CcpaRequests"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
